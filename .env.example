# Laravel API base URL — the prefix where API routes live.
# Example local: http://localhost:8000/api
# Example prod:  https://api.neomap.mn/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Laravel root URL (no /api). Used to hit /sanctum/csrf-cookie before
# stateful mutations. Must share a parent domain with NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_SANCTUM_URL=http://localhost:8000

# When "true", the listings API client returns data from local fixtures
# (src/infrastructure/data/listings.ts) instead of calling Laravel.
# Useful while the backend is being built; flip to "false" once it is up.
NEXT_PUBLIC_USE_MOCK_API=true
