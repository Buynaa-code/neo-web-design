# Neomap / RiskSolution API base URL — the prefix where API routes live.
# Auth is Bearer-token based (Sanctum personal access tokens): the token is
# returned by /auth/login & /auth/register and stored in localStorage by the
# client (no CSRF cookie / stateful session needed).
#
# Example prod:  https://core.neomap.mn/api
# Example local: http://localhost:8000/api
NEXT_PUBLIC_API_URL=https://core.neomap.mn/api

# Neodata map/layer service — a SEPARATE host/service from the above, used to
# resolve district/khoroo from a map bbox (wizard "pin a building" step).
NEXT_PUBLIC_NEODATA_API_URL=https://data.neomap.mn/api
